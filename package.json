{
  "name": "@allons-y/eleventy-plugin-netlify-data-store",
  "version": "0.1.1",
  "description": "Read & write build-time content for Eleventy from Netlify Blobs, with a TTL-based local cache for fast, offline-tolerant builds.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "changeset": "changeset",
    "ci:test": "ava",
    "docs:build": "eleventy --config=website/eleventy.config.js",
    "docs:start": "eleventy --serve --config=website/eleventy.config.js",
    "docs:test": "cypress run --project website",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "release": "changeset publish",
    "sample": "NODE_ENV=development eleventy --config=sample/eleventy.config.js --input=sample --output=sample/_site",
    "test": "ava",
    "test:watch": "ava --watch"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "eleventy",
    "eleventy-plugin",
    "netlify",
    "netlify-blobs",
    "data-store",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allonsy-studio/eleventy-plugin-netlify-data-store.git"
  },
  "bugs": "https://github.com/allonsy-studio/eleventy-plugin-netlify-data-store/issues",
  "homepage": "https://github.com/allonsy-studio/eleventy-plugin-netlify-data-store#readme",
  "author": {
    "name": "Allons-y Studio",
    "url": "https://allons-y.studio"
  },
  "ava": {
    "failFast": false,
    "files": [
      "test/*.test.js"
    ],
    "watchMode": {
      "ignoreChanges": [
        "**/_site/**",
        "**/.netlify/**"
      ]
    }
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@11ty/eleventy": {
      "optional": true
    }
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.0",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@allons-y/dashly": "^0.1.0-beta.0",
    "@allons-y/opx-cli": "^0.1.0-beta.0",
    "@allons-y/opx-lint-js": "^1.0.0-beta.1",
    "@allons-y/opx-lint-json": "^0.1.0-beta.0",
    "@allons-y/opx-lint-md": "^0.1.0-beta.0",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.2",
    "ava": "^6.4.1",
    "axe-core": "^4.11.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-license-header": "^0.9.0",
    "markdown-it": "^14.1.0",
    "prismjs": "^1.30.0"
  },
  "dependenciesMeta": {
    "cypress": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1",
  "oss-docs": {
    "site": "website",
    "flavor": "docs"
  }
}
