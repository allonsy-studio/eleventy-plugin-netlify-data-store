<!--- Footer block: project links, license, then the studio layer unless the project opts out. --->
<footer>
	<div>
		<div>
			<p><strong @text="$data.site.name"></strong></p>
			<p @text="$data.site.tagline + '.'"></p>
			<p>
				<small>
					Licensed under
					<a :href="$data.site.licenseUrl" data-license @text="$data.site.license"></a>
				</small>
			</p>
		</div>
		<nav aria-label="Project links">
			<p><strong>Project</strong></p>
			<ul>
				<li><a :href="$data.site.repo"><span class="fa-brands fa-github" aria-hidden="true"></span>GitHub</a></li>
				<li webc:if="$data.site.npm"><a :href="$data.site.npm"><span class="fa-brands fa-npm" aria-hidden="true"></span>npm</a></li>
				<li><a :href="$data.site.changelogUrl"><span class="fa-solid fa-list" aria-hidden="true"></span>Changelog</a></li>
			</ul>
		</nav>
		<nav aria-label="Help links">
			<p><strong>Help</strong></p>
			<ul>
				<li><a :href="$data.site.issuesUrl"><span class="fa-solid fa-bug" aria-hidden="true"></span>Report an issue</a></li>
				<li><a :href="$data.site.contributingUrl"><span class="fa-solid fa-code-pull-request" aria-hidden="true"></span>Contributing guide</a></li>
				<li><a :href="$data.studio.conductUrl"><span class="fa-solid fa-scale-balanced" aria-hidden="true"></span>Code of conduct</a></li>
				<li><a :href="$data.studio.securityUrl"><span class="fa-solid fa-shield-halved" aria-hidden="true"></span>Security policy</a></li>
			</ul>
		</nav>
	</div>
	<div webc:if="$data.site.studio">
		<studio-cta></studio-cta>
		<studio-footer></studio-footer>
	</div>
</footer>
